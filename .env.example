# Nama aplikasi
VITE_APP_NAME=Cakra Enterprise

# URL dasar API backend (tanpa trailing slash)
VITE_API_BASE_URL=/api/v1

# Aktifkan mock API hanya untuk development lokal
VITE_USE_MOCK=false

# Target CI4 untuk proxy Vite saat development (Apache/CI4 lokal)
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8080
