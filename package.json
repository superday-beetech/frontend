{
  "name": "cakra-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "check:arch": "node scripts/check-architecture.mjs",
    "check": "npm run check:arch && npm run typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,css}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:module": "node scripts/new-module.mjs"
  },
  "dependencies": {
    "@vue/devtools-api": "^8.2.1",
    "@vueup/vue-quill": "^1.5.5",
    "axios": "^1.21.1",
    "localforage": "^1.10.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "quill": "^2.0.3",
    "vue": "^3.5.44",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
